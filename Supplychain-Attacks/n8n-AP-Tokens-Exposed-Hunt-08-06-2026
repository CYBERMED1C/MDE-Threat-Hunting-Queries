// n8n API token exposure and abuse hunt
// Broad organizational hunt — no n8n hostname/domain required
// Source: https://thehackernews.com/2026/08/leaked-n8n-api-tokens-exposed-live.html
// Author: Robert Boettger - AKA CYBERMEDIC	
// The hunt should inspect all available MDE telemetry for token exposure, and
// API enumeration, workflow manipulation, credential access, and suspicious execution
let Lookback = 30d;
let N8nIndicators = dynamic([
    "x-n8n-api-key",
    "n8n_api_key",
    "n8n-api-key",
    "n8n_api_url",
    "n8n_url",
    "n8n_host",
    "n8n_mcp_url",
    "n8n_webhook_base_url",
    "/api/v1/users",
    "/api/v1/workflows",
    "/api/v1/credentials",
    "/api/v1/executions",
    "/api/v1/data-tables",
    "/api/v1/variables",
    "/api/v1/audit",
    "includedata=true"
]);
union isfuzzy=true
(
    DeviceProcessEvents
    | where Timestamp >= ago(Lookback)
    | extend SearchData = tolower(
        strcat(
            FileName, " ",
            FolderPath, " ",
            ProcessCommandLine, " ",
            InitiatingProcessFileName, " ",
            InitiatingProcessCommandLine
        )
    )
    | where SearchData has_any (N8nIndicators)
        or (
            SearchData contains "n8n"
            and SearchData has_any (
                "curl",
                "wget",
                "invoke-restmethod",
                "invoke-webrequest",
                "powershell",
                "python",
                "node",
                "httpie",
                "authorization",
                "bearer",
                "api-key"
            )
        )
    | extend MatchReason = case(
        SearchData contains "x-n8n-api-key"
            or SearchData contains "n8n_api_key"
            or SearchData contains "n8n-api-key",
            "n8n API key reference or possible token exposure",

        SearchData contains "/api/v1/credentials",
            "n8n credential enumeration or access",

        SearchData contains "/api/v1/executions"
            and SearchData contains "includedata=true",
            "n8n execution data retrieved with includeData=true",

        SearchData contains "/api/v1/variables",
            "n8n variable enumeration or access",

        SearchData contains "/api/v1/users",
            "n8n user enumeration",

        SearchData contains "/api/v1/audit",
            "n8n security audit API access",

        SearchData contains "/api/v1/data-tables",
            "n8n data-table access",

        SearchData contains "/api/v1/workflows"
            and SearchData matches regex
                @"(-x|--request|-method)\s*(post|put|patch|delete)",
            "n8n workflow creation, modification, activation, or deletion",

        SearchData contains "/api/v1/workflows",
            "n8n workflow API access",

        SearchData contains "n8n",
            "n8n-related command-line activity",

        "n8n indicator detected"
    )
    | extend Severity = case(
        MatchReason contains "token exposure", "High",
        MatchReason contains "credential", "High",
        MatchReason contains "includeData", "High",
        MatchReason contains "creation", "High",
        MatchReason contains "variable", "Medium",
        MatchReason contains "enumeration", "Medium",
        "Informational"
    )
    | project
        Timestamp,
        DeviceName,
        DeviceId,
        SourceTable = "DeviceProcessEvents",
        Severity,
        MatchReason,
        ActionType,
        AccountName,
        FileName,
        FolderPath,
        ProcessCommandLine,
        InitiatingProcessFileName,
        InitiatingProcessCommandLine,
        RemoteUrl = "",
        RemoteIP = "",
        RemotePort = int(null),
        FilePath = "",
        AdditionalFields = "",
        ReportId
),
(
    DeviceNetworkEvents
    | where Timestamp >= ago(Lookback)
    | extend SearchData = tolower(
        strcat(
            RemoteUrl, " ",
            RemoteIP, " ",
            InitiatingProcessFileName, " ",
            InitiatingProcessFolderPath, " ",
            InitiatingProcessCommandLine, " ",
            AdditionalFields
        )
    )
    | where SearchData has_any (N8nIndicators)
        or (
            SearchData contains "n8n"
            and SearchData has_any (
                "curl",
                "wget",
                "powershell",
                "python",
                "node",
                "api",
                "token",
                "credential",
                "workflow"
            )
        )
    | extend MatchReason = case(
        SearchData contains "x-n8n-api-key"
            or SearchData contains "n8n_api_key"
            or SearchData contains "n8n-api-key",
            "Possible n8n API key used in network activity",

        SearchData contains "/api/v1/executions"
            and SearchData contains "includedata=true",
            "Complete n8n execution data requested",

        SearchData contains "/api/v1/credentials",
            "n8n credentials API accessed",

        SearchData contains "/api/v1/variables",
            "n8n variables API accessed",

        SearchData contains "/api/v1/users",
            "n8n users API accessed",

        SearchData contains "/api/v1/audit",
            "n8n audit API accessed",

        SearchData contains "/api/v1/data-tables",
            "n8n data-table API accessed",

        SearchData contains "/api/v1/workflows",
            "n8n workflow API accessed",

        "Other n8n-related network activity"
    )
    | extend Severity = case(
        MatchReason contains "API key", "High",
        MatchReason contains "credentials", "High",
        MatchReason contains "execution data", "High",
        MatchReason contains "variables", "Medium",
        MatchReason contains "users", "Medium",
        "Informational"
    )
    | project
        Timestamp,
        DeviceName,
        DeviceId,
        SourceTable = "DeviceNetworkEvents",
        Severity,
        MatchReason,
        ActionType,
        AccountName = InitiatingProcessAccountName,
        FileName = InitiatingProcessFileName,
        FolderPath = InitiatingProcessFolderPath,
        ProcessCommandLine = InitiatingProcessCommandLine,
        InitiatingProcessFileName = InitiatingProcessParentFileName,
        InitiatingProcessCommandLine = "",
        RemoteUrl,
        RemoteIP,
        RemotePort,
        FilePath = "",
        AdditionalFields = tostring(AdditionalFields),
        ReportId
),
(
    DeviceFileEvents
    | where Timestamp >= ago(Lookback)
    | extend FilePath = strcat(FolderPath, "/", FileName)
    | extend SearchData = tolower(
        strcat(
            FilePath, " ",
            InitiatingProcessFileName, " ",
            InitiatingProcessCommandLine
        )
    )
    | where
        SearchData contains "n8n"
        or (
            SearchData has_any (
                ".env",
                "settings.json",
                "settings.local.json",
                "docker-compose.yml",
                "docker-compose.yaml",
                "environment"
            )
            and SearchData has_any (
                "n8n",
                "api_key",
                "api-key",
                "token"
            )
        )
    | extend MatchReason = case(
        SearchData contains ".env",
            "Potential n8n secret or API token stored in an environment file",

        SearchData contains "settings.local.json"
            or SearchData contains "settings.json",
            "Potential n8n token stored in an application settings file",

        SearchData contains "docker-compose",
            "n8n container configuration file activity",

        "n8n-related file activity"
    )
    | extend Severity = case(
        MatchReason contains "secret", "Medium",
        MatchReason contains "token", "Medium",
        "Informational"
    )
    | project
        Timestamp,
        DeviceName,
        DeviceId,
        SourceTable = "DeviceFileEvents",
        Severity,
        MatchReason,
        ActionType,
        AccountName = InitiatingProcessAccountName,
        FileName,
        FolderPath,
        ProcessCommandLine = InitiatingProcessCommandLine,
        InitiatingProcessFileName,
        InitiatingProcessCommandLine,
        RemoteUrl = "",
        RemoteIP = "",
        RemotePort = int(null),
        FilePath,
        AdditionalFields = "",
        ReportId
),
(
    DeviceEvents
    | where Timestamp >= ago(Lookback)
    | extend SearchData = tolower(
        strcat(
            ActionType, " ",
            FileName, " ",
            FolderPath, " ",
            InitiatingProcessFileName, " ",
            InitiatingProcessCommandLine, " ",
            AdditionalFields
        )
    )
    | where SearchData has_any (N8nIndicators)
        or SearchData contains "n8n"
    | extend MatchReason = case(
        SearchData contains "x-n8n-api-key"
            or SearchData contains "n8n_api_key"
            or SearchData contains "n8n-api-key",
            "n8n API key indicator present in device telemetry",

        SearchData contains "/api/v1/credentials",
            "n8n credential API indicator present",

        SearchData contains "/api/v1/executions",
            "n8n execution API indicator present",

        SearchData contains "/api/v1/workflows",
            "n8n workflow API indicator present",

        "Other n8n artifact present in device telemetry"
    )
    | extend Severity = case(
        MatchReason contains "API key", "High",
        MatchReason contains "credential", "High",
        "Informational"
    )
    | project
        Timestamp,
        DeviceName,
        DeviceId,
        SourceTable = "DeviceEvents",
        Severity,
        MatchReason,
        ActionType,
        AccountName = InitiatingProcessAccountName,
        FileName,
        FolderPath,
        ProcessCommandLine = InitiatingProcessCommandLine,
        InitiatingProcessFileName,
        InitiatingProcessCommandLine,
        RemoteUrl = "",
        RemoteIP = "",
        RemotePort = int(null),
        FilePath = strcat(FolderPath, "/", FileName),
        AdditionalFields = tostring(AdditionalFields),
        ReportId
)
| extend ThreatName = "n8n API Token Exposure or Abuse"
| order by
    case(
        Severity == "High", 1,
        Severity == "Medium", 2,
        3
    ) asc,
    Timestamp desc
