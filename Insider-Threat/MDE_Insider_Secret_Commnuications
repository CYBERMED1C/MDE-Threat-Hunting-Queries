let DomainHits = DeviceNetworkEvents
| where Timestamp >= ago(Lookback)
| extend RemoteHost = tolower(tostring(RemoteUrl))
| mv-apply Domain = CommunicationDomains to typeof(string) on (where RemoteHost contains Domain)
| extend Account = iff(isnotempty(InitiatingProcessAccountUpn),InitiatingProcessAccountUpn,InitiatingProcessAccountName)
| extend MatchType = "Communication Domain", Indicator = Domain
| project Timestamp,DeviceName,Account,MatchType,Indicator,ProcessName=InitiatingProcessFileName,ProcessCommandLine=InitiatingProcessCommandLine,RemoteUrl,RemoteIP,RemotePort=tostring(RemotePort);
let NetworkProcessHits = DeviceNetworkEvents
| where Timestamp >= ago(Lookback)
| where InitiatingProcessFileName in~ (CommunicationProcesses)
| extend Account = iff(isnotempty(InitiatingProcessAccountUpn),InitiatingProcessAccountUpn,InitiatingProcessAccountName)
| extend MatchType = "Communication EXE", Indicator = InitiatingProcessFileName
| project Timestamp,DeviceName,Account,MatchType,Indicator,ProcessName=InitiatingProcessFileName,ProcessCommandLine=InitiatingProcessCommandLine,RemoteUrl,RemoteIP,RemotePort=tostring(RemotePort);
let ProcessHits = DeviceProcessEvents
| where Timestamp >= ago(Lookback)
| where FileName in~ (CommunicationProcesses)
| extend Account = iff(isnotempty(AccountUpn),AccountUpn,AccountName)
| extend MatchType = "Communication EXE", Indicator = FileName
| project Timestamp,DeviceName,Account,MatchType,Indicator,ProcessName=FileName,ProcessCommandLine,RemoteUrl="",RemoteIP="",RemotePort="";
union DomainHits,NetworkProcessHits,ProcessHits
| distinct Timestamp,DeviceName,Account,MatchType,Indicator,ProcessName,ProcessCommandLine,RemoteUrl,RemoteIP,RemotePort
| order by Timestamp desc