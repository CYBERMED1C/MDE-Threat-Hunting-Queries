// Detection of files copied/created from removable storage USB
// Author : CYBERMEDIC
// Last updated : 2026-08-31
DeviceFileEvents
| where Timestamp >= ago(30d)
| where ActionType in ("FileCreated", "FileRenamed", "FileModified")
// Check if the file extension is an executable type
| where FileName endswith ".exe" 
    or FileName endswith ".scr" 
    or FileName endswith ".com" 
    or FileName endswith ".bat" 
    or FileName endswith ".cmd" 
    or FileName endswith ".ps1" 
    or FileName endswith ".dll"
// Filter for operations involving removable media
| where InitiatingProcessFileName =~ "explorer.exe" or isnotempty(InitiatingProcessCommandLine)
| where AdditionalFields contains "RemovableStorage" 
    or AdditionalFields contains "UsbDrive" 
    or AdditionalFields contains "VolumeType"
    or AdditionalFields matches regex @"[D-Z]:\\" // Captures source drive paths common for USB mounts
| project
    Timestamp,
    DeviceName,
    ActionType,
    FileName,
    FolderPath,
    SHA256,
    InitiatingProcessAccountName,
    InitiatingProcessFileName,
    InitiatingProcessCommandLine,
    AdditionalFields
| sort by Timestamp desc
